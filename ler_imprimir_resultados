def ler_arquivo(nome_arquivo):
    """Retorna uma lista de tuplas (nome, média final, legenda)."""
    alunos = []
    try:
        with open(nome_arquivo, "r", encoding="utf-8") as arq:
            for linha in arq:
                linha = linha.strip()
                if not linha:
                    continue
                campos = linha.split(";")
                nome = campos[0]
                legenda = campos[-1]
                media = campos[6] if len(campos) == 8 else campos[4]
                alunos.append((nome, media, legenda))
    except FileNotFoundError:
        print(f"Arquivo {nome_arquivo} não encontrado.")
    return alunos


def main():
    alunos = ler_arquivo("aprovados.txt") + ler_arquivo("reprovados.txt")

    print("=" * 52)
    print(f"{'ALUNO':<22}{'MÉDIA':>7}   SITUAÇÃO")
    print("=" * 52)

    if not alunos:
        print("Nenhum aluno encontrado.")
        return

    for nome, media, legenda in sorted(alunos, key=lambda a: a[0].lower()):
        print(f"{nome:<22}{media:>7}   {legenda}")

    print("=" * 52)
    print(f"Total de alunos: {len(alunos)}")


if __name__ == "__main__":
    main()
